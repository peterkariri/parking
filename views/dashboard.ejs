
<!DOCTYPE html>
<html>
<head>
    <title>ParkEase | Dashboard</title>
<link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <nav>
        <h2>ParkEase</h2>

        <a href="/dashboard">Dashboard</a>
        <a href="/profile">My Profile</a>

        <form action="/logout" method="POST">
            <button type="submit">Logout</button>
        </form>
    </nav>

    <main>
        <h1>Welcome, <%= user.name %></h1>
        <p>Explore parking facilities in Eldoret.</p>

        <h2>Available Parking Facilities</h2>

        <% if (lots.length === 0) { %>
            <p>No parking facilities have been registered yet.</p>
        <% } %>

        <% lots.forEach(lot => { %>
            <div class="parking-card">

                <h3><%= lot.name %></h3>

                <p>Location: <%= lot.location %></p>

                <p>Capacity: <%= lot.capacity %> vehicles</p>

                <a href="/parking-lots/<%= lot.id %>">
                    View Parking Bays
                </a>

            </div>
        <% }) %>

    </main>

</body>
</html>
